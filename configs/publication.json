{
  "schema_version": 2,
  "profile": "publication",
  "purpose": "Numerical protocol and checked-in data used for the DIAL publication figures.",
  "scientific_evidence": true,
  "datasets": {
    "main_benchmark": "results/publication/main_benchmark.json",
    "transient_excitation": "results/publication/transient_excitation.json",
    "misalignment_n3": "results/publication/misalignment_n3.json"
  },
  "protocols": {
    "main_benchmark": {
      "benchmark": "main_direct_inversion",
      "ensemble_selection": "first N prespecified realizations; no residual or fidelity filtering",
      "n_min": 2,
      "n_max": 5,
      "n_systems": 100,
      "target_phase": 0.7853981633974483,
      "d_min_factor": 0.45,
      "d_min_rule": "0.45 * minimum_transition_spacing",
      "chi_tone_spacing": 0.075,
      "r_disp": 0.1,
      "ratio_max": 10.0,
      "seed": 20260818,
      "sobol_power": 12,
      "span": 1.35,
      "grid_points": 6401,
      "candidate_pool_mode": "full_admissible_grid",
      "omega_hw_max": 1000000.0,
      "steps_per_period": 12,
      "max_steps": 120000000,
      "map_only": false
    },
    "transient_excitation": {
      "source": "results/publication/main_benchmark.json",
      "definition": "Maximum transient mediator excitation over the integration grid and register inputs."
    },
    "misalignment_n3": {}
  },
  "figure_generation": {
    "command": "python scripts/reproduce_figures.py",
    "outputs": [
      "manuscript/figures/main_direct_inversion_scaling.pdf",
      "manuscript/figures/benchmark_ensemble_n3_normalized_spectral_space.pdf",
      "manuscript/figures/scaling_relative_minimum_spacing.pdf",
      "manuscript/figures/dial_misalignment_audit.pdf"
    ]
  },
  "optional_numerical_regeneration": {
    "main_benchmark": "python scripts/run_main_benchmark.py",
    "transient_excitation": "python scripts/run_transient_excitation_audit.py",
    "misalignment_n3": "python scripts/run_misalignment_audit.py"
  }
}
